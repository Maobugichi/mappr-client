\ No newline at end of file
+}
+
+/* The inspector overlays the canvas; it never pushes or relayouts nodes.
+   Keeping the element mounted lets close transitions finish and reverses
+   cleanly when a new selection happens during an exit. */
+.mappr-node-inspector {
+  opacity: 0;
+  visibility: hidden;
+  pointer-events: none;
+  transform: translateX(var(--motion-distance));
+  transition:
+    opacity var(--motion-fast) var(--motion-ease-exit),
+    transform var(--motion-standard) var(--motion-ease-exit),
+    visibility 0s linear var(--motion-standard);
+}
+
+.mappr-node-inspector[data-open="true"] {
+  opacity: 1;
+  visibility: visible;
+  pointer-events: auto;
+  transform: translateX(0);
+  transition:
+    opacity var(--motion-fast) var(--motion-ease-enter),
+    transform var(--motion-standard) var(--motion-ease-enter),
+    visibility 0s;
+}
